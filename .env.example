# ------------------------------------------------------------------
# ADSolution — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# On Cloudflare Pages set these under Settings → Environment variables.
# ------------------------------------------------------------------

# --- Frontend (public; baked into the static build) -------------------
# Where the contact form POSTs. Leave unset to use the bundled
# Cloudflare Pages Function at /api/contact.
# NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# --- Cloudflare Pages Function: /functions/api/contact.ts (secrets) ----
# Resend API key (https://resend.com). Mark as "Secret" in Cloudflare.
RESEND_API_KEY=
# Inbox that receives inquiries. admin@adsolution.men is forwarded by
# Cloudflare Email Routing; neangreasey@hotmail.com also works directly.
CONTACT_TO=admin@adsolution.men
# Verified sender. Must be on a domain verified in Resend.
CONTACT_FROM=ADSolution Website <noreply@adsolution.men>
